    {
      "ConcreteType": "Dynamo.Nodes.DSModelElementSelection, DSRevitNodesUI",
      "NodeType": "ExtensionNode",
      "InstanceId": [
        "43a4bf7e-de79-4b12-a6c0-2df3cb70f261-000ad39d"
      ],
      "Id": "cef1a0dcbffb474180ef1456d6e8334a",
      "Inputs": [],
      "Outputs": [
        {
          "Id": "292e7a0703f34be4b976cd3f3d5b68d6",
          "Name": "Element",
          "Description": "The selected elements.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Select a model element from the document."
    },
    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "Code": "import clr\r\nimport math\r\n\r\nclr.AddReference(\"RevitAPI\")\r\nimport Autodesk.Revit.DB as DB\r\n\r\nclr.AddReference(\"RevitServices\")\r\nfrom RevitServices.Persistence import DocumentManager\r\nfrom RevitServices.Transactions import TransactionManager\r\n\r\ndoc = DocumentManager.Instance.CurrentDBDocument\r\n\r\n# INPUTS\r\ntiles = UnwrapElement(IN[0])\r\nreference_tile = UnwrapElement(IN[1])\r\n\r\nif not isinstance(tiles, list):\r\n    tiles = [tiles]\r\n\r\nDOME_CODE = \"D01\"\r\nPARENT_CODE = \"DOME_01\"\r\n\r\n# Si S02-S07 van en sentido contrario, cambiar a False\r\nCLOCKWISE = True\r\n\r\n# Tolerancia para reconocer una misma fila V\r\n# Revit trabaja internamente en pies.\r\nROW_TOLERANCE = 0.08\r\n\r\n\r\ndef element_center(el):\r\n    bb = el.get_BoundingBox(None)\r\n\r\n    if bb is None:\r\n        return None\r\n\r\n    return (\r\n        (bb.Min.X + bb.Max.X) / 2.0,\r\n        (bb.Min.Y + bb.Max.Y) / 2.0,\r\n        (bb.Min.Z + bb.Max.Z) / 2.0\r\n    )\r\n\r\n\r\n# ------------------------------------------------\r\n# 1. Centres of all tiles\r\n# ------------------------------------------------\r\n\r\ndata = []\r\n\r\nfor tile in tiles:\r\n    c = element_center(tile)\r\n\r\n    if c is not None:\r\n        data.append({\r\n            \"element\": tile,\r\n            \"x\": c[0],\r\n            \"y\": c[1],\r\n            \"z\": c[2]\r\n        })\r\n\r\n\r\n# ------------------------------------------------\r\n# 2. Dome centre in plan\r\n# ------------------------------------------------\r\n\r\ncx = sum(d[\"x\"] for d in data) / len(data)\r\ncy = sum(d[\"y\"] for d in data) / len(data)\r\n\r\nref = element_center(reference_tile)\r\n\r\nref_angle = math.atan2(\r\n    ref[1] - cy,\r\n    ref[0] - cx\r\n)\r\n\r\nsector_angle = 2.0 * math.pi / 7.0\r\n\r\n\r\n# ------------------------------------------------\r\n# 3. Detect sector S01-S07\r\n# ------------------------------------------------\r\n\r\ngroups = {}\r\n\r\nfor i in range(1, 8):\r\n    groups[\"S{:02d}\".format(i)] = []\r\n\r\nfor d in data:\r\n\r\n    angle = math.atan2(\r\n        d[\"y\"] - cy,\r\n        d[\"x\"] - cx\r\n    )\r\n\r\n    if CLOCKWISE:\r\n        delta = (ref_angle - angle) % (2.0 * math.pi)\r\n    else:\r\n        delta = (angle - ref_angle) % (2.0 * math.pi)\r\n\r\n    sector_index = int(\r\n        math.floor(\r\n            (delta + sector_angle / 2.0) / sector_angle\r\n        )\r\n    ) % 7\r\n\r\n    sector = \"S{:02d}\".format(sector_index + 1)\r\n    d[\"sector\"] = sector\r\n\r\n    # Centre direction of this sector\r\n    if CLOCKWISE:\r\n        sector_centre_angle = (\r\n            ref_angle - sector_index * sector_angle\r\n        )\r\n    else:\r\n        sector_centre_angle = (\r\n            ref_angle + sector_index * sector_angle\r\n        )\r\n\r\n    # Local lateral coordinate for U\r\n    tangent_x = -math.sin(sector_centre_angle)\r\n    tangent_y = math.cos(sector_centre_angle)\r\n\r\n    d[\"local_u\"] = (\r\n        (d[\"x\"] - cx) * tangent_x +\r\n        (d[\"y\"] - cy) * tangent_y\r\n    )\r\n\r\n    groups[sector].append(d)\r\n\r\n\r\n# ------------------------------------------------\r\n# 4. Determine V rows and U positions\r\n# ------------------------------------------------\r\n\r\nresults = []\r\nrow_counts = {}\r\n\r\nTransactionManager.Instance.EnsureInTransaction(doc)\r\n\r\nfor sector in sorted(groups.keys()):\r\n\r\n    sector_tiles = groups[sector]\r\n\r\n    # Highest tiles first = V01\r\n    sector_tiles = sorted(\r\n        sector_tiles,\r\n        key=lambda x: x[\"z\"],\r\n        reverse=True\r\n    )\r\n\r\n    rows = []\r\n\r\n    for tile in sector_tiles:\r\n\r\n        assigned = False\r\n\r\n        for row in rows:\r\n\r\n            row_z = sum(\r\n                x[\"z\"] for x in row\r\n            ) / float(len(row))\r\n\r\n            if abs(tile[\"z\"] - row_z) <= ROW_TOLERANCE:\r\n                row.append(tile)\r\n                assigned = True\r\n                break\r\n\r\n        if not assigned:\r\n            rows.append([tile])\r\n\r\n    # Ensure V01 is the upper row\r\n    rows = sorted(\r\n        rows,\r\n        key=lambda row:\r\n            sum(x[\"z\"] for x in row) / float(len(row)),\r\n        reverse=True\r\n    )\r\n\r\n    row_counts[sector] = len(rows)\r\n\r\n    for v_index, row in enumerate(rows):\r\n\r\n        V = v_index + 1\r\n\r\n        # Left → right = U01, U02...\r\n        row = sorted(\r\n            row,\r\n            key=lambda x: x[\"local_u\"]\r\n        )\r\n\r\n        for u_index, d in enumerate(row):\r\n\r\n            U = u_index + 1\r\n            tile = d[\"element\"]\r\n\r\n            hdt_id = \"{}_{}_U{:02d}_V{:02d}\".format(\r\n                DOME_CODE,\r\n                sector,\r\n                U,\r\n                V\r\n            )\r\n\r\n            p_id = tile.LookupParameter(\"HDT_Element_ID\")\r\n            p_parent = tile.LookupParameter(\"HDT_Parent_ID\")\r\n            p_zone = tile.LookupParameter(\"HDT_Zone\")\r\n\r\n            if p_id and not p_id.IsReadOnly:\r\n                p_id.Set(hdt_id)\r\n\r\n            if p_parent and not p_parent.IsReadOnly:\r\n                p_parent.Set(PARENT_CODE)\r\n\r\n            if p_zone and not p_zone.IsReadOnly:\r\n                p_zone.Set(sector)\r\n\r\n            results.append([\r\n                tile.Id.Value,\r\n                hdt_id\r\n            ])\r\n\r\nTransactionManager.Instance.TransactionTaskDone()\r\n\r\n\r\nOUT = {\r\n    \"Total tiles\": len(data),\r\n    \"V rows detected\": row_counts,\r\n    \"IDs written\": len(results),\r\n    \"Generated IDs\": results\r\n}",
      "Engine": "CPython3",
      "VariableInputPorts": true,
      "Id": "d157b996d6ed40a286bc1270bcce5aaf",
      "NodeType": "PythonScriptNode",
      "Inputs": [
        {
          "Id": "ea89efae18ed468da8574a07225440c7",
          "Name": "IN[0]",
          "Description": "Input #0",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "98e5c1b371324ae48b4292d6b9e13f94",
          "Name": "IN[1]",
          "Description": "Input #1",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "8ac62f41040b4163b84e47a31ae74680",
          "Name": "OUT",
          "Description": "Result of the python script",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Runs an embedded Python script."
    },
